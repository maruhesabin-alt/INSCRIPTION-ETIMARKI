# Copiez ce fichier en ".env" (même dossier) et remplacez les valeurs d'exemple.
# Une valeur par ligne, sans espace autour du "=", sans commentaire en fin de ligne.
# NE PARTAGEZ JAMAIS le fichier .env et ne l'ajoutez jamais à un ZIP ou à un dépôt public.

# Compte administrateur créé au premier lancement (mot de passe : 10 caractères minimum)
ADMIN_EMAIL=maruhesabin80@gmail.com
ADMIN_PASSWORD=981170238845360603
# Facultatif
PORT=3000
# Clé qui chiffre les clés API des sources (sinon générée dans data/secret.key). Gardez-la sauvegardée.
# SECRET_KEY=une-longue-phrase-secrete
# Autorise l'analyse de services situés sur votre propre machine ou réseau local (1 = oui)
# ALLOW_PRIVATE_SOURCES=0
# Nombre de sauvegardes conservées (défaut 14) ; BACKUP_AUTO=0 désactive les sauvegardes automatiques
# BACKUP_KEEP=14
